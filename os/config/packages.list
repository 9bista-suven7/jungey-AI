# Everything the installed system has. Installed without recommends, so each
# package here is wanted on purpose. One per line; '#' starts a comment.

# --- Base system ---
ubuntu-minimal
linux-image-generic-hwe-24.04
initramfs-tools
plymouth-theme-spinner
systemd-zram-generator
sudo
locales
tzdata
console-setup
keyboard-configuration
bash-completion
command-not-found
less
nano
vim-tiny
htop
curl
wget
ca-certificates
gnupg
openssh-client
rsync
zip
unzip
xz-utils
zstd
pciutils
usbutils
lsb-release
software-properties-common
unattended-upgrades
# Keeps Intel laptops from overheating and throttling.
thermald

# --- Boot loader ---
# grub-pc serves BIOS machines; the signed EFI images and shim serve UEFI,
# including with Secure Boot on. The installer uses whichever the machine needs.
grub-pc
grub-efi-amd64-bin
grub-efi-amd64-signed
shim-signed
efibootmgr
mokutil
os-prober

# --- Disks and filesystems ---
e2fsprogs
dosfstools
ntfs-3g
exfatprogs
cryptsetup
cryptsetup-initramfs
udisks2
gvfs
gvfs-backends
gvfs-fuse

# --- Network, sound, bluetooth ---
network-manager
# NetworkManager hands DNS to systemd-resolved, and /etc/resolv.conf points at it.
systemd-resolved
network-manager-gnome
wpasupplicant
iw
rfkill
wireless-regdb
bluez
blueman
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
# PipeWire's Bluetooth plugin: without it headphones pair but play nothing.
libspa-0.2-bluetooth
alsa-utils
# Intel "Smart Sound" (most Intel laptops from 2019 on) has no sound without
# this firmware and ALSA's device profiles. linux-firmware only recommends it.
firmware-sof-signed
alsa-ucm-conf
alsa-topology-conf
pulseaudio-utils
pavucontrol

# --- Graphics ---
xserver-xorg-core
xserver-xorg-video-all
xserver-xorg-input-all
x11-xserver-utils
x11-utils
xdg-utils
xdg-user-dirs
xdg-user-dirs-gtk
dbus-user-session
dbus-x11
at-spi2-core
mesa-utils
# Hardware video decoding (Intel, then AMD), so videos play cool and cheaply.
intel-media-va-driver
mesa-va-drivers

# --- Desktop: Xfce ---
lightdm
lightdm-gtk-greeter
light-locker
xfce4
xfce4-terminal
xfce4-whiskermenu-plugin
xfce4-pulseaudio-plugin
xfce4-power-manager
xfce4-notifyd
xfce4-screenshooter
xfce4-taskmanager
thunar-volman
thunar-archive-plugin
tumbler
policykit-1-gnome
gnome-keyring
libpam-gnome-keyring
xfce4-systemload-plugin
orchis-gtk-theme
papirus-icon-theme
dmz-cursor-theme
librsvg2-common
fonts-inter
fonts-jetbrains-mono
fonts-ubuntu
fonts-dejavu-core
fonts-liberation2
fonts-noto-color-emoji
fonts-lohit-deva

# --- Applications ---
epiphany-browser
mousepad
ristretto
atril
parole
cheese
xarchiver
synaptic
gstreamer1.0-plugins-good
gstreamer1.0-libav

# --- Developer tools ---
zsh
zsh-autosuggestions
zsh-syntax-highlighting
git
tmux
neovim
geany
python3-venv
python3-pip
jq
tree
neofetch

# --- Jungey's optional helpers (voice, camera, screen reading) ---
espeak-ng
ffmpeg
tesseract-ocr
brightnessctl
