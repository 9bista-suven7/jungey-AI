# Everything the installed system has. Installed without recommends, so each
# package here is wanted on purpose. One per line; '#' starts a comment.

# --- Base system ---
ubuntu-minimal
linux-image-generic-hwe-24.04
initramfs-tools
systemd-zram-generator
sudo
locales
tzdata
console-setup
keyboard-configuration
