zip
unzip
xz-utils
zstd
pciutils
usbutils
lsb-release
software-properties-common
unattended-upgrades

# --- Boot loader ---
# grub-pc serves BIOS machines; the signed EFI images and shim serve UEFI,
# including with Secure Boot on. The installer uses whichever the machine needs.
grub-pc
grub-efi-amd64-bin
grub-efi-amd64-signed
shim-signed
efibootmgr
mokutil
os-prober

# --- Disks and filesystems ---
e2fsprogs
dosfstools
ntfs-3g
exfatprogs
cryptsetup
cryptsetup-initramfs
udisks2
gvfs
gvfs-backends
gvfs-fuse

