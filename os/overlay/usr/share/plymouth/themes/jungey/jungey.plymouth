[Plymouth Theme]
Name=Jungey
Description=Jungey OS: the arc reactor turning over while the system starts.
ModuleName=two-step

[two-step]
Font=Inter 12
TitleFont=Inter Light 26
ImageDir=/usr/share/plymouth/themes/jungey
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.80
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.25
HorizontalAlignment=.5
VerticalAlignment=.44
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.66
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x0b1b28
BackgroundEndColor=0x02060a
ProgressBarBackgroundColor=0x14303f
ProgressBarForegroundColor=0x3cc8f2
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false
UseFirmwareBackground=false

[shutdown]
UseEndAnimation=false
UseFirmwareBackground=false

[reboot]
UseEndAnimation=false
UseFirmwareBackground=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing updates...
SubTitle=Do not turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading Jungey OS...
SubTitle=Do not turn off your computer

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading firmware...
SubTitle=Do not turn off your computer

[system-reset]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Resetting Jungey OS...
SubTitle=Do not turn off your computer
