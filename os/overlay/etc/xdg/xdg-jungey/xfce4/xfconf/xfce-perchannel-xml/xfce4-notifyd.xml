<?xml version="1.0" encoding="UTF-8"?>
<!-- Notifications in the Jungey style, top right, just under the panel. -->
<channel name="xfce4-notifyd" version="1.0">
  <property name="theme" type="string" value="Jungey"/>
  <property name="notify-location" type="uint" value="2"/>
  <property name="initial-opacity" type="double" value="0.96"/>
  <property name="expire-timeout" type="int" value="6"/>
  <property name="do-fadeout" type="bool" value="true"/>
  <property name="do-slideout" type="bool" value="true"/>
</channel>
